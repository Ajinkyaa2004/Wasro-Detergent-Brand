# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# private credentials reference (Upstash, admin pwd, SMTP, etc.) — never commit
/_secrets/

# private business documents (signed contract, invoices, debtor PII) — never commit
/_docs/

# consolidated local backup of every image the site actually uses (mirror of
# /public). Handy single-folder reference for editing; NOT needed in the repo
# since the deployable copies already live in /public.
/_used-images/

# Selenium suite local artifacts
/tests/.venv/
/tests/screenshots/
/tests/report.html

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
