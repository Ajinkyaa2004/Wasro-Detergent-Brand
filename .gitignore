# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# private credentials reference (Upstash, admin pwd, SMTP, etc.) — never commit
/_secrets/

# private business documents (signed contract, invoices, debtor PII) — never commit
/_docs/

# image working folders — sources, AI generations & scratch. The deployable app
# ships only from /public, so these (~150MB) are kept out of the repo.
/Creatives/
/Images/
/generated_images/
/new_images/

# stray root-level logo working copies (canonical versions live in /public)
/logo.png
/logo1.png
/logo1-cropped.png

# Selenium suite local artifacts
/tests/.venv/
/tests/screenshots/
/tests/report.html

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
